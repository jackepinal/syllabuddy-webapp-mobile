# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From console.anthropic.com -> API Keys. Used server-side only (never exposed
# to the browser) to read uploaded syllabi and pull out grading categories,
# assignments, and meeting times. Phase 2 (syllabus upload) won't work without
# this.
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: override the Claude model used for syllabus extraction.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
